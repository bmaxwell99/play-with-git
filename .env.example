# Copy to .env (which is gitignored) and fill in. Never commit real keys.

# seats.aero Partner API key — https://seats.aero (Pro/API tier, ~$10/mo)
SEATSAERO_API_KEY=

# Anthropic API key — only needed for --llm ranking
ANTHROPIC_API_KEY=

# Amadeus Self-Service (cash flights + hotels) — free tier at
# https://developers.amadeus.com (create an app -> API Key + API Secret).
# Test environment by default; set AMADEUS_BASE_URL=https://api.amadeus.com for prod.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
